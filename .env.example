# Required for Prisma (build runs `prisma generate` + `migrate deploy`). On Vercel, set in Project → Settings → Environment Variables.
DATABASE_URL="postgresql://user:password@localhost:5432/stock_analysis"
ANGELONE_API_KEY="your_angel_one_api_key"
ANGELONE_CLIENT_ID="your_client_id"
ANGELONE_PASSWORD="your_password"

# DeepSeek (OpenAI-compatible API) — used for intent classification / routing
DEEPSEEK_API_KEY="your_deepseek_api_key"
# Optional: override base URL if using LiteLLM proxy or self-hosted DeepSeek
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# Optional: override model id (default: deepseek-chat)
# DEEPSEEK_MODEL="deepseek-chat"

# Amazon Bedrock — powers Compute 1.0 (the main AI engine, Claude Sonnet 4.6)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="ap-south-1"
BEDROCK_MODEL_ID="global.anthropic.claude-sonnet-4-6"

# Razorpay Payments (Pro autopay at /pricing)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_PLAN_ID="plan_xxxxxxxxxxxx"   # Razorpay Dashboard → Subscriptions → Plans
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_key_id"
# Webhook secret from Razorpay Dashboard → Webhooks → https://www.istocks.codes/api/payments/razorpay-webhook
# RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
SERPER_API_KEY="your_serper_api_key"
GOOGLE_SEARCH_API_KEY="your_google_search_api_key"
GOOGLE_SEARCH_ENGINE_ID="your_google_search_engine_id"
NODE_ENV="development"
TZ="Asia/Kolkata"

# Canonical site origin for Open Graph / metadata (no trailing slash). Falls back to https://istocks.codes.
# NEXT_PUBLIC_SITE_URL="https://istocks.codes"
# If unset, NEXTAUTH_URL is used when defined (same normalization).

# Live quotes: EC2 Angel feed + Yahoo fallback (see GET /api/live-price)
# EC2_LIVE_SERVER_URL="http://13.203.192.234:8080"
# When EC2 is down or returns an empty feed, bare GET /api/live-price reads symbols from the Stock table and returns Yahoo quotes.
# LIVE_PRICE_BATCH_LIMIT=120
# LIVE_PRICE_YAHOO_CACHE_TTL_MS=15000
# LIVE_PRICE_DB_SYMBOL_CACHE_TTL_MS=60000
# LIVE_PRICE_EC2_FULL_TIMEOUT_MS=55000
# LIVE_PRICE_EC2_BATCH_TIMEOUT_MS=25000

# Experts panel LLM routing
# Providers: bedrock | qwen | openai-compatible
EXPERT_KRISHNA_PROVIDER="bedrock"
EXPERT_CHANAKYA_PROVIDER="bedrock"
EXPERT_ARYABHATA_PROVIDER="qwen"
EXPERT_SYNTHESIZER_PROVIDER="bedrock"

# Qwen OpenAI-compatible defaults used by Aryabhata
QWEN_API_KEY="your_qwen_api_key"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# Optional per-agent model overrides
EXPERT_KRISHNA_MODEL="global.anthropic.claude-sonnet-4-6"
EXPERT_CHANAKYA_MODEL="global.anthropic.claude-sonnet-4-6"
EXPERT_ARYABHATA_MODEL="qwen-plus"
EXPERT_SYNTHESIZER_MODEL="global.anthropic.claude-sonnet-4-6"

# Optional broker API overrides
GROWW_API_BASE_URL="https://api.groww.in"
GROWW_API_VERSION="1.0"
GROWW_TOKEN_KEY_TYPE="approval"

# Firecrawl (powers Morningstar India + PMS Bazaar integrations)
# FIRECRAWL_API_KEY="your_firecrawl_api_key"

# Telegram Bot
# TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# Cron secret (guards Vercel cron endpoints)
# CRON_SECRET="your_random_secret"

# Trading safety
# LIVE_TRADING_ENABLED="false"
# LIVE_MAX_ORDER_VALUE="500000"
# BROKER_CREDS_ENC_KEY="your_32_byte_aes_key"

# NextAuth
# NEXTAUTH_URL="http://localhost:3002"
# NEXTAUTH_SECRET="your_nextauth_secret"
# GOOGLE_CLIENT_ID="your_google_client_id"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Internal admin dashboard (/internal) — move off hardcoded defaults in production
# INTERNAL_ADMIN_USER="istocks0"
# INTERNAL_ADMIN_PASSWORD="your_secure_password"
# INTERNAL_SESSION_SECRET="random_secret_for_internal_cookie_signing"
